# ==============================================================================
# AI Sub Worker Configuration (worker.yaml or <hostname>.worker.yaml)
# ==============================================================================

# Server Connection
server_url: "https://sub.yourdomain.com"
server_auth: "worker_user:your_secure_password"
worker_id: "test-worker-1" # Defaults to machine hostname if omitted

# Concurrency & Work Limits
concurrency: 2 # Number of video chunk tasks to process simultaneously (Default: 2)
max_tasks: 0 # Exit after N tasks (0 runs until queue is empty or quotas exhausted)
max_duration_minutes: 0 # Exit after N minutes, draining active tasks (0 runs without time limit)
heartbeat_interval_seconds: 30.0
claim_poll_interval_minutes: 3.0 # Standby poll interval in minutes when waiting on busy slots

# Gemini API Configuration
gemini_key: "AIzaSyYourGeminiApiKeyHere"

# Gemini Models Supported by This Worker
models:
  - "google-gla:gemini-3.8-flash"
  - "google-gla:gemini-3.6-flash"
  - "google-gla:gemini-3.5-flash-lite"

# Auxiliary Search & Lyrics Providers
search:
  tools:
    - "tinyfish"
    - "lrclib"
    - "duckduckgo"
  tinyfish_key: "sk-tinyfish-your-tinyfish-api-key"
  # langsearch_key: "your-langsearch-key"
  # ollama_key: "your-ollama-key"

# Local Storage & Tracking Files
quota_file: ".ai-sub-quota.json"
temp_dir: "./ai_sub_worker"