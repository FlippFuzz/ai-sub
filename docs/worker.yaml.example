# ==============================================================================
# AI Sub Worker Configuration (worker.yaml or <hostname>.worker.yaml)
# All time durations are in seconds (numeric) or ISO 8601 duration strings.
# ==============================================================================

# Server Connection & Worker Identity
serverurl: "https://sub.yourdomain.com"
serverauth: "worker_user:your_secure_password"
# id: "test-worker-1"          # Defaults to SHA-256 hash of hostname if omitted

# Concurrency & Work Limits
concurrency: 2                 # Concurrent task slots per model (e.g. 2 slots x 4 models = 8 total)
idletimeout: 900               # Seconds all slots must remain idle before exiting (0 exits immediately)
pollinterval: 180              # Seconds between poll attempts when a slot has no tasks
maxduration: 0                 # Exit after N seconds, draining active tasks (0 disables)
maxtasks: 0                    # Exit after N tasks per model (0 runs until idle timeout or quota exhausted)
heartbeatinterval: 30          # Seconds between lease heartbeat pings

# Gemini Models Supported by This Worker
models:
  - "gemini-4-hydrogen"
  - "gemini-3.8-flash"
  - "gemini-3.6-flash"
  - "gemini-3.5-flash-lite"

# Local Working Directory for Media Downloads
workdir: "./ai_sub_worker"

# Logging & Telemetry
log:
  level: "info"
  timestamps: false
  scrub: true
  # token: null                # Optional Logfire write token (or set LOGFIRE_TOKEN)

# AI Execution Engine & Auxiliary Providers
ai:
  key: "AIzaSyYourGeminiApiKeyHere"
  # baseurl: "https://your-custom-gemini-proxy.com"
  rpm: 4
  tpm: 250000
  # models:                    # Optional per-model rate limit overrides (omitted fields inherit above)
  #   gemini-3.5-flash-lite:
  #     rpm: 15
  #     tpm: 1000000

  storage:
    max: "15GB"
    target: "10GB"
    cleanupinterval: 1800      # Seconds (30 minutes)
    pollinterval: 10           # Seconds

  search:
    tools:
      - "tinyfish"
      - "lrclib"
      - "duckduckgo"
    tinyfishkey: "sk-tinyfish-your-tinyfish-api-key"
    # langsearchkey: "your-langsearch-key"
    # ollamakey: "your-ollama-key"
    maxturns: 3
    qps: 0.3
    maxlength: 4096
    timeout: 60                # Seconds
    retries: 3
    backoff:
      multiplier: 2.0
      minwait: 5               # Seconds
      maxwait: 60              # Seconds