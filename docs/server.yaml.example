# ==============================================================================
# AI Sub Server Configuration (server.yaml or <hostname>.server.yaml)
# All time durations are in seconds (numeric) or ISO 8601 duration strings.
# ==============================================================================

# HTTP Server Binding
http:
  host: "127.0.0.1"
  port: 8000

# Coordinator Orchestration Options
coordinator:
  workdir: "./work"
  heartbeattimeout: 300        # Lease expiration timeout in seconds
  validationbuffer: 2          # Allowed subtitle end timestamp buffer in seconds
  activitymaxlen: 50           # Maximum worker activity events preserved per pipeline

# Task Execution and Distributed Retry Controls
retry:
  perturn: 5                   # Transient API retries per turn (network, 5xx, rate-limit)
  validation: 3                # Full-session retries on schema validation failure
  maxruns: 3                   # Non-retryable worker failures per FPS tier before fallback/exhaustion
  backoff:
    multiplier: 2.0
    minwait: 30                # Seconds
    maxwait: 300               # Seconds

# Git Repository Synchronization Settings
git:
  repourl: "https://github.com/YourUsername/subtitles-archive.git"  # null disables Git sync
  branch: "main"
  pat: "ghp_your_github_token_here"
  # playerurl: "https://flippfuzz.github.io/ai-sub-player"

# Media Intake Sources
sources:
  # Local Filesystem Intake
  files:
    folders:
      - "/home/ubuntu/videos/intake"
    interval: 120              # Rescan interval in seconds (2 minutes)
    maxstembytes: 100          # Maximum UTF-8 byte length for local output folder and SRT stems

  # YouTube Feed Intake
  youtube:
    urls:
      - "https://www.youtube.com/playlist?list=PLxxxxxxxxxxxxxxxx"
      - "https://www.youtube.com/@ChannelName/videos"
    interval: 3600             # Base scan interval in seconds (60 minutes)
    lookback: 259200           # Minimum age window for delta scans in seconds (72 hours; 0 disables)
    jitter: 900                # Symmetric jitter in seconds (+/- 15 mins; 0 disables)
    channeldelay: 5            # Jittered pause between scraping channels in seconds (0 disables)

    channelsfile: "channels.json"
    # proxy: "http://127.0.0.1:40000"
    cookiefile: "/home/ubuntu/ai-sub-server/cookie.txt"

    potdir: "bgutil-ytdlp-pot-provider"  # null disables PO token provider

    maxfailures: 3             # Consecutive download failures before pausing YouTube intake
    cooldown: 3600             # YouTube cooldown duration in seconds (60 minutes)

# Video Re-encoding and Compression Controls
reencode:
  encoder: null                # null auto-detects working H.264 encoder
  concurrency: 1               # Maximum concurrent FFmpeg processes across runners

  summary:
    threshold: "500MB"         # 0 disables initial re-encoding
    fps: "keyframes"           # "keyframes" or numeric FPS (e.g. 1.0)
    height: 360
    bitrate: "35KB"            # Bytes per second (35KB = 280 kbps)
    tolerance: 0.1             # Seconds
    fallback:
      attempts: 5              # 0 disables fallback re-encoding
      multiplier: 2.0          # Divides base FPS per fallback tier

  segment:
    threshold: "50MB"          # 0 disables initial re-encoding
    fps: 1.0
    height: 360
    bitrate: "35KB"
    tolerance: 0.1
    fallback:
      attempts: 5
      multiplier: 2.0

# Segmentation / Splitting Settings
split:
  duration: 300                # Chunk duration in seconds (5 minutes)
  offset: 0                    # Start offset to skip in seconds (0 disables)
  tolerance: 0.1               # Seconds

# Logging & Telemetry
log:
  level: "info"
  timestamps: false
  scrub: true

# Active Pipeline Combinations
pipelines:
  - name: "combo_40f"
    summary:
      model: "gemini-3.5-flash-lite"
      # agentic: true
    subtitles:
      model: "gemini-4-hydrogen"
      # agentic: false
    lyrics:
      model: "gemini-3.5-flash-lite"
      # agentic: true
    # searchtools: ["tinyfish", "lrclib"]

  - name: "combo_35l"
    summary:
      model: "gemini-3.5-flash-lite"
    subtitles:
      model: "gemini-3.5-flash-lite"
    lyrics:
      model: "gemini-3.5-flash-lite"