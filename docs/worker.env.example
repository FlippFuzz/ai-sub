# ==============================================================================
# AI Sub Worker Environment Configuration (.env)
# Copy to .env in your worker directory: cp docs/worker.env.example .env
# ==============================================================================

# --- Server Connection ---
# Public URL of the ai-sub-server (behind Nginx reverse proxy with HTTPS)
AISUB_WORKER_SERVER_URL="https://sub.yourdomain.com"

# Basic Auth credentials in "username:password" format matching /etc/nginx/.htpasswd
AISUB_WORKER_SERVER_AUTH="worker_user:your_secure_password"

# Unique identifier for this worker node (defaults to hostname if unset)
AISUB_WORKER_WORKER_ID="oracle-e2-worker-1"

# --- Gemini API Configuration ---
# Google Gemini API key used by this worker to upload chunks and run models
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Models offered by this worker (JSON list format)
AISUB_WORKER_MODELS='["google-gla:gemini-3.8-flash", "google-gla:gemini-3.6-flash", "google-gla:gemini-3.5-flash-lite"]'

# --- Auxiliary Web Search & Lyrics Tool API Keys ---
# Search tools enabled on this worker (comma-separated: tinyfish, lrclib, duckduckgo, etc.)
AISUB_AI_SEARCH_TOOLS="tinyfish,lrclib,duckduckgo"

# Dedicated API key for Tinyfish web search and full page extraction
TINYFISH_API_KEY="tf-your-tinyfish-api-key"

# Optional search keys (if using Langsearch or Ollama)
# LANGSEARCH_API_KEY="your-langsearch-key"
# OLLAMA_API_KEY="your-ollama-key"

# --- Worker Runtime & Execution Tuning ---
# Maximum tasks to process before exiting cleanly (0 runs until queue is empty or quotas exhausted)
AISUB_WORKER_MAX_TASKS=0

# Interval in seconds between heartbeat pings sent to the server to renew task lease
AISUB_WORKER_HEARTBEAT_INTERVAL_SECONDS=30.0

# Path to local human-readable quota JSON tracking Pacific Time (00:00 PT) resets
AISUB_WORKER_QUOTA_FILE=".ai-sub-quota.json"

# Local scratch directory for temporary 5-minute media chunks (~10MB, deleted immediately after task)
AISUB_WORKER_TEMP_DIR="/tmp/ai_sub_worker"

# --- Logging & Telemetry ---
AISUB_LOG_LEVEL="info"

# Optional Logfire token to send worker traces to the same dashboard as the server
# LOGFIRE_TOKEN="your_logfire_token_here"